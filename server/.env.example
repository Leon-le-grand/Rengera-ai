# Environment for the V2 FastAPI server. Copy to `.env`; never commit a real `.env`.
APP_ENV="development"
APP_NAME="Rengera AI API"
APP_VERSION="0.1.0"
APP_URL=""
# Exact comma-separated origins. Wildcards and paths are rejected.
ALLOWED_ORIGINS="http://localhost:5173"
LOG_LEVEL="INFO"
REQUEST_ID_HEADER="X-Request-ID"
MAX_REQUEST_BYTES="1000000"

# Server-only Postgres connection. Leave empty for foundation-only local work.
DATABASE_URL=""
DATABASE_SSL="true"
DB_POOL_MIN_SIZE="1"
DB_POOL_MAX_SIZE="10"

# Server-only. Never expose these through a client bundle.
SUPABASE_URL=""
# Not required by the current public slice; keep server-only when used.
SUPABASE_SERVICE_ROLE_KEY=""
# Required for first-party email/password sign-in through Supabase GoTrue.
SUPABASE_ANON_KEY=""
# Verify Supabase-issued access tokens with either a shared secret or JWKS URL.
SUPABASE_JWT_SECRET=""
SUPABASE_JWKS_URL=""

# Browser session and CSRF cookies.
SESSION_COOKIE_NAME="rengera_session"
CSRF_COOKIE_NAME="rengera_csrf"
COOKIE_SECURE="true"
SESSION_TTL_SECONDS="28800"

# OpenAI-compatible provider. The model ID belongs here, never in feature code.
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
AI_TIMEOUT_SECONDS="60"
