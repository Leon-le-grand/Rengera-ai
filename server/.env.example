# Environment for the V2 FastAPI server. Copy to `.env`; never commit a real `.env`.
APP_ENV="development"
APP_NAME="Rengera AI API"
APP_VERSION="0.1.0"
APP_URL=""
# Exact comma-separated origins. Wildcards and paths are rejected.
ALLOWED_ORIGINS="http://localhost:5173"
LOG_LEVEL="INFO"
REQUEST_ID_HEADER="X-Request-ID"
MAX_REQUEST_BYTES="1000000"

# Server-only Postgres connection. Leave empty for foundation-only local work.
DATABASE_URL=""
DATABASE_SSL="true"
DB_POOL_MIN_SIZE="1"
DB_POOL_MAX_SIZE="10"

# Browser session and CSRF cookies.
SESSION_COOKIE_NAME="rengera_session"
CSRF_COOKIE_NAME="rengera_csrf"
COOKIE_SECURE="true"
SESSION_TTL_SECONDS="28800"

# Optional path to a versioned, server-owned policy JSON file.
AGENT_POLICY_FILE=""
# To enable the packaged policy locally, use AGENT_POLICY_FILE="config/agent-policy.json".
# Export this secret into the server process environment.
RENGERA_AI_PROVIDER_OPENAI=""

# Optional staff invitation delivery. Configure an authorized TLS SMTP relay.
# STAFF_INVITE_ORIGIN=https://platform.example.com
# STAFF_SMTP_HOST=smtp.example.com
# STAFF_SMTP_PORT=465
# STAFF_SMTP_USERNAME=
# STAFF_SMTP_PASSWORD=
# STAFF_SMTP_FROM=staff-invitations@example.com

# Private S3-compatible PDF storage. Use separate credentials and buckets per environment.
PDF_STORAGE_ENDPOINT_URL=""
PDF_STORAGE_BUCKET=""
PDF_STORAGE_ACCESS_KEY_ID=""
PDF_STORAGE_SECRET_ACCESS_KEY=""
PDF_STORAGE_REGION="auto"
PDF_STORAGE_UPLOAD_URL_TTL_SECONDS="300"
PDF_STORAGE_DOWNLOAD_URL_TTL_SECONDS="300"
PDF_STORAGE_MAX_PDF_BYTES="52428800"
