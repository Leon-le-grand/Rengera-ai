FROM node:22-bookworm-slim AS platform-build
WORKDIR /build
RUN npm install --global pnpm@12.14.0
COPY platform/package.json platform/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY platform/ ./
ENV VITE_API_BASE_URL=/
RUN pnpm build

FROM python:3.12-slim-bookworm AS runtime
WORKDIR /app
ENV APP_ENV=production PYTHONUNBUFFERED=1 UV_PYTHON_DOWNLOADS=never PATH="/app/.venv/bin:$PATH"
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /usr/local/bin/uv
COPY server/pyproject.toml server/uv.lock ./
RUN uv sync --frozen --no-dev
COPY server/app/ ./app/
COPY server/config/ ./config/
ENV AGENT_POLICY_FILE=/app/config/agent-policy.json
COPY --from=platform-build /build/dist/ ./platform_dist/
RUN useradd --system --no-create-home rengera
USER rengera
EXPOSE 3000
CMD ["sh", "-c", "exec uvicorn app.deployment:create_deployment --factory --host 0.0.0.0 --port ${PORT:-3000}"]
