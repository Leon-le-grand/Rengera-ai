# Space Bunny OpenAI-compatible API access.
# Keep the real API key in .env.local or your Vercel server-side secrets.
SPACE_BUNNY_API_KEY=""
SPACE_BUNNY_API_URL="https://api.aimlapi.com/v1"
SPACE_BUNNY_MODEL="stealth/space-bunny-alpha"

# Model choice: any OpenAI-compatible chat model ID works here — classification,
# answers and summary translations all follow SPACE_BUNNY_MODEL with no code change.
#
# OpenCode inference (https://opencode.ai/inference/openai/v1) also speaks this
# protocol and hosts Muse Spark, Fledge Alpha and others. LIMITATION, verified
# by direct test: OpenCode's FREE tier answers only from inside OpenCode itself
# ("FreeTierError" over plain HTTPS). The deployed app therefore cannot use the
# free models keyless. What works: create a service account in the OpenCode
# Console (Keys -> Add Service Account -> Inference-only key, oc_sk_...), set it
# as SPACE_BUNNY_API_KEY with SPACE_BUNNY_API_URL below, and paid models
# (e.g. claude-sonnet-4-6) bill to that workspace budget.
# SPACE_BUNNY_API_URL="https://opencode.ai/inference/openai/v1"
# SPACE_BUNNY_MODEL="muse-spark-1.3-contributor-free"
#
# Optional fallback provider: used only when the primary fails. Same shape —
# useful as a second key/model pair.
AI_FALLBACK_API_KEY=""
AI_FALLBACK_API_URL="https://api.aimlapi.com/v1"
AI_FALLBACK_MODEL=""

# Optional. When omitted, chat works but article embeddings/retrieval are skipped.
SPACE_BUNNY_EMBEDDING_MODEL=""

# Supabase server-side configuration. Never expose the service-role key publicly.
# The service-role key is also what backs citizen sign-up/sign-in, so it is
# required for accounts. Run migrations 001 through 007 before using them.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# Public application URL, when your host provides one.
APP_URL=""

# Google Play listing URL for the footer download badge. Safe to leave empty;
# the badge renders but does not navigate until a listing exists.
NEXT_PUBLIC_PLAY_STORE_URL=""

# Demo defaults used when these variables are not set.
# Replace them before exposing the administrator portal publicly.
ADMIN_EMAIL="admin"
ADMIN_PASSWORD="admin123"

# Optional production overrides. Generate a strong AUTH_SECRET and password hash.
# Without AUTH_SECRET a public development fallback is used, which must never
# reach a production deployment.
AUTH_SECRET=""
ADMIN_PASSWORD_HASH=""
