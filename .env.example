# Gemini AI access. Keep the real value in .env.local or your Vercel secrets.
GEMINI_API_KEY=""

# Optional alias for deployments that prefer the SPACE_BUNNY_API_KEY name.
# Its value must still be a valid Gemini API key.
SPACE_BUNNY_API_KEY=""

# Public application URL, when your host provides one.
APP_URL=""

# Local development defaults. The code ignores these demo values in production.
ADMIN_EMAIL="admin"
ADMIN_PASSWORD="admin123"

# Production authentication. Generate a strong AUTH_SECRET and set a password hash.
AUTH_SECRET=""
ADMIN_PASSWORD_HASH=""
