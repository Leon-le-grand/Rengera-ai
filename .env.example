# Gemini AI access. Keep the real value in .env.local or your Vercel secrets.
GEMINI_API_KEY=""

# Optional alias for deployments that prefer the SPACE_BUNNY_API_KEY name.
# Its value must still be a valid Gemini API key.
SPACE_BUNNY_API_KEY=""

# Public application URL, when your host provides one.
APP_URL=""

# Demo defaults used when these variables are not set.
# Replace them before exposing the administrator portal publicly.
ADMIN_EMAIL="admin"
ADMIN_PASSWORD="admin123"

# Optional production overrides. Generate a strong AUTH_SECRET and password hash.
AUTH_SECRET=""
ADMIN_PASSWORD_HASH=""
